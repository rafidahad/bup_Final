# Copy to .env and adjust. Never commit .env.
SIMULATION_SPEED=8          # ticks per real second; use 1 for a human-paced demo
TICK_MINUTES=15
SIMULATOR_START_MODE=paused
SIM_PORT=18000              # host port for the simulator (8000 is often reserved on Windows)
APP_PORT=8100
FUELOPS_POLICY=lp-buffer    # lp-buffer | lp | threshold
FUELOPS_MODE=manual         # observe | manual | auto
FUELOPS_OPERATOR_TOKEN=     # set a secret to protect lab, mode and planner changes
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me
