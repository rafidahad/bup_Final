# Copy to .env (local) or paste into Dokploy → Compose → Environment (production).
# Never commit real values. Comments must be on their own line (Dokploy / dotenv safe).

# Simulator: ticks per real second (1 = human-paced demo), minutes per tick, start paused
SIMULATION_SPEED=8
TICK_MINUTES=15
SIMULATOR_START_MODE=paused

# Host ports, bound to 127.0.0.1 only (Dokploy/Traefik routes the public domains)
SIM_PORT=18000
APP_PORT=8100
PROMETHEUS_PORT=9090
# 3300, not 3000: Dokploy's panel uses 3000
GRAFANA_PORT=3300

# Planner: lp-buffer | lp | threshold. Mode: observe | manual | auto
FUELOPS_POLICY=lp-buffer
FUELOPS_MODE=auto

# Secret for lab, mode and planner changes. Generate: openssl rand -hex 32
FUELOPS_OPERATOR_TOKEN=

# Grafana admin password and its public URL (production: https://tae-grafana.rafidahad.me)
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://localhost:3300

# --- AI (plan Revision 5) ---
# Chronos-2-Small forecaster container (shadow mode: the planner keeps the formula)
FORECAST_ENABLED=true
FORECAST_PORT=8200
# Incident summaries by an LLM on Groq; without a key, rule-based summaries are used
SUMMARIES_ENABLED=true
# Your Groq key (console.groq.com). Backend only: never commit .env, never put it in a VITE_ variable
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq free tier allows 8,000 tokens/min; one summary is ~2-4k tokens
GROQ_MAX_CALLS_PER_MINUTE=3
